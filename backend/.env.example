PORT=4000
# Use mongodb://127.0.0.1:27017 for local MongoDB or your Atlas connection string.
# DB_NAME is selected separately by the backend.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=mediconnect
JWT_SECRET=replace_with_a_long_random_secret_before_deployment
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
CLIENT_URLS=http://localhost:5173,http://localhost:5174

# Optional: required only for image uploads (profile photos / doctor images).
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
